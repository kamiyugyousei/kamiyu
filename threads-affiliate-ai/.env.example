# ============================================================
# Threads Affiliate AI - Environment Variables
# Copy this file to `.env` and fill in the values.
# The system runs end-to-end even with blanks (safe mock mode).
# ============================================================

# --- LLM (optional: falls back to deterministic templates if empty) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Threads (Meta Graph API) - only needed to actually publish ---
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# --- Rakuten (PHASE 1) ---
RAKUTEN_APPLICATION_ID=
RAKUTEN_AFFILIATE_ID=
RAKUTEN_ACCESS_KEY=

# --- A8.net (PHASE 2) ---
A8_LOGIN_ID=
A8_ENABLED=false

# --- Database ---
DATABASE_URL=sqlite:///./data/threads_ai.db

# --- Safety / Behavior toggles ---
AUTO_PUBLISH=false
TARGET_POSTS_PER_DAY=10
AFFILIATE_POSTS_PER_DAY=4
VALUE_POSTS_PER_DAY=3
CONVERSATION_POSTS_PER_DAY=2
EXPERIMENT_POSTS_PER_DAY=1
MAX_AFFILIATE_POSTS_PER_DAY=4

MIN_POST_INTERVAL_MINUTES=60
MIN_AFFILIATE_SCORE=70
MIN_COMPLIANCE_SCORE=90
COPY_SIMILARITY_THRESHOLD=0.80

# Research budget: minimum % of research kept for exploration (never 100% exploit)
MIN_EXPLORATION_RATIO=0.20

# Posting window (posts staggered between these hours). 毎朝8時から投稿開始。
FIRST_POST_HOUR=8
LAST_POST_HOUR=22

# Auto-generate today's candidates when the app starts (double-click -> ready)
GENERATE_ON_STARTUP=true

# --- Browser research (Playwright). Respect robots/ToS. No CAPTCHA/login bypass. ---
BROWSER_ENABLED=false
BROWSER_HEADLESS=true

# --- Scheduler cron times (24h, local / Asia/Tokyo) ---
CRON_DAILY_RESEARCH=06:00
CRON_KEYWORD_DISCOVERY=06:30
CRON_PRODUCT_MATCHING=06:45
CRON_CONTENT_GENERATION=07:00
CRON_DAILY_ANALYSIS=23:00
CRON_STRATEGY_UPDATE=00:00

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
# Public deployment lock (leave password blank for local-only use).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
